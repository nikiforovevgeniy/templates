# Скопируйте этот файл в .env и при необходимости поправьте значения.
# Переменные должны начинаться с VITE_, иначе Vite не отдаст их клиенту.

# Включает моки MSW в браузере (обработчики — в src/shared/api-mocks).
# Работает только в dev-режиме: прод-сборка вырезает моки независимо
# от значения, см. проверку import.meta.env.DEV в src/app/main.tsx.
VITE_ENABLE_API_MOCKS = true
